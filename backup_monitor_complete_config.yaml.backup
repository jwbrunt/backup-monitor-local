# Backup Monitor Configuration for space.edirepository.org
# Complete backup monitoring with traditional /backup + failover /backup1/backup2

backup_locations:
  # Traditional backup monitoring (like old bash system)
  - name: "Main Backup"
    type: "local"
    path: "/backup"
    description: "Traditional main backup directory"
    exclude_patterns:
      - "/backup/tmp"
      - "/backup/CARC"
      - "/backup/lost+found"
      - "/backup/gmn-lter/gmn_object_store"
    max_depth: 3

  # Failover backup directories - will monitor whichever is active
  - name: "Backup1"
    type: "local"
    path: "/backup1"
    description: "Failover backup location option 1"
    failover_group: "secondary_backup"
    exclude_patterns: []
    max_depth: 2  # Shallower depth for failover monitoring
    
  - name: "Backup2" 
    type: "local"
    path: "/backup2"
    description: "Failover backup location option 2"
    failover_group: "secondary_backup"
    exclude_patterns:
      - "/backup2/lost+found"
    max_depth: 2  # Shallower depth for failover monitoring

# Email configuration using sendEmail
email:
  # Use sendEmail command instead of SMTP for HTML emails
  use_sendemail: true
  smtp_server: "email-smtp.us-west-2.amazonaws.com"
  smtp_port: 587
  smtp_user: "AKIAUVWTLDG24NS37N5B"
  smtp_pass: "BL2LAdL31+Iyu7diXZnntlVnMaZ2+w8VBDUVlxgH7d6o"
  from_address: "jwbrunt@gmail.com"
  to_addresses:
    - "jwbrunt@gmail.com"
  subject_prefix: "space.edirepository.org Complete Backup Report"

# Monitoring configuration
monitoring:
  max_depth: 3          # Default depth (can be overridden per location)
  days_back: 7          # Look for files modified in last N days
  max_dirs: 200         # Maximum directories to process per location
  file_size_limit_mb: 100
  timeout_seconds: 600  # Longer timeout for multiple locations

# Logging configuration
logging:
  level: "INFO"
  file: "/home/pasta/.backup-monitor/logs/backup_monitor.log"
  max_size_mb: 10
  backup_count: 5
  console: true

# Report configuration
reports:
  format: "both"  # text, html, or both
  save_local: true
  local_directory: "/home/pasta/backup_reports"
  retention_days: 30
